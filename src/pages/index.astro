---
// Heaven Furniture Mart — landing page.
// A clean list of self-contained sections, composed in order (§4).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import BrandIntro from '../components/BrandIntro.astro';
import WhyChoose from '../components/WhyChoose.astro';
import Collections from '../components/Collections.astro';
import Bespoke from '../components/Bespoke.astro';
import SignaturePieces from '../components/SignaturePieces.astro';
import SocialProof from '../components/SocialProof.astro';
import Location from '../components/Location.astro';
import CallToAction from '../components/CallToAction.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header slot="header" />

  <Hero />
  <TrustStrip />
  <BrandIntro />
  <WhyChoose />
  <Collections />
  <Bespoke />
  <SignaturePieces />
  <SocialProof />
  <Location />
  <CallToAction />

  <Footer slot="footer" />
</BaseLayout>
