---
/* CallToAction (§4.9) — one dominant action (WhatsApp). Call + showroom are
   quiet secondaries so nothing competes with the primary. */
import { BUSINESS } from '../consts';
---
<section class="cta section" id="contact" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__panel" data-reveal>
      <div class="cta__glow" aria-hidden="true"></div>

      <p class="eyebrow cta__eyebrow">Let's begin</p>
      <h2 id="cta-title" class="cta__title">
        Let's design something<br />made only for <em>you</em>.
      </h2>
      <p class="cta__lead">
        Tell us about your space. A free consultation is the first step toward
        furniture that fits your life exactly.
      </p>

      <a class="btn btn--primary cta__primary" href={BUSINESS.whatsapp} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.73 1.2h.01c5.46 0 9.91-4.45 9.91-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.81.83-3.02-.2-.31a8.17 8.17 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.24-8.23a8.2 8.2 0 0 1 8.22 8.24c0 4.54-3.69 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.16.04-.31-.02-.43-.06-.13-.56-1.35-.76-1.85-.2-.48-.4-.42-.56-.43-.14-.01-.31-.01-.47-.01-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.16 1.73 2.64 4.19 3.7.58.25 1.04.4 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z" />
        </svg>
        Chat on WhatsApp
      </a>

      <div class="cta__secondary">
        <a href={BUSINESS.phoneHref} class="cta__link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6.5 3.5 9 4l1 4-2 1.5a12 12 0 0 0 6 6L15.5 15l4 1 .5 2.5a2 2 0 0 1-2 2.2A16 16 0 0 1 4.3 5.5a2 2 0 0 1 2.2-2Z" />
          </svg>
          {BUSINESS.phoneDisplay}
        </a>
        <span class="cta__divider" aria-hidden="true"></span>
        <span class="cta__link cta__link--static">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
          {BUSINESS.address.full}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta__panel {
    position: relative;
    overflow: hidden;
    background: var(--cta-bg);
    color: var(--cta-fg);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: clamp(var(--radius-lg), 3vw, 32px);
    padding: clamp(2.6rem, 7vw, 5.5rem) clamp(1.5rem, 6vw, 4rem);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .cta__glow {
    position: absolute;
    inset: auto -10% -60% -10%;
    height: 90%;
    background: radial-gradient(
      50% 60% at 50% 100%,
      color-mix(in srgb, var(--accent) 34%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .cta__eyebrow { position: relative; color: var(--accent-on-dark); }
  .cta__title {
    position: relative;
    margin-top: 1rem;
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.08;
    color: var(--cta-fg);
  }
  .cta__title em { font-style: italic; color: var(--accent); }

  .cta__lead {
    position: relative;
    margin: 1.4rem auto 0;
    max-width: 48ch;
    font-size: var(--step-1);
    color: var(--cta-fg-muted);
    line-height: 1.55;
  }

  .cta__primary {
    position: relative;
    margin-top: 2.4rem;
    --btn-py: 1.05rem;
    --btn-px: 2rem;
    font-size: var(--step-1);
  }

  .cta__secondary {
    position: relative;
    margin-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    color: var(--cta-fg-muted);
    font-size: var(--step--1);
  }
  .cta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--cta-fg-muted);
    letter-spacing: 0.02em;
    transition: color 0.25s var(--ease);
  }
  .cta__link svg { width: 1.05em; height: 1.05em; color: var(--accent); flex: none; }
  a.cta__link:hover { color: var(--cta-fg); }
  .cta__link--static { cursor: default; }
  .cta__divider { width: 1px; height: 16px; background: color-mix(in srgb, var(--cta-fg) 30%, transparent); }

  @media (max-width: 560px) {
    .cta__secondary { flex-direction: column; gap: 0.7rem; }
    .cta__divider { display: none; }
  }
</style>
