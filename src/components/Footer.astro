---
/* Footer (§4.10) — brand, address, phone, email, socials. */
import { BUSINESS } from '../consts';

const year = new Date().getFullYear();
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const socials = [
  {
    name: 'Facebook',
    href: BUSINESS.social.facebook,
    path: 'M14 8.5h2.5V5H14c-2 0-3.5 1.6-3.5 3.6V10H8v3.5h2.5V21H14v-7.5h2.4L17 10h-3V8.7c0-.6.4-1.2 1-1.2Z',
  },
  {
    name: 'Instagram',
    href: BUSINESS.social.instagram,
    path: 'M7.5 3.5h9A4 4 0 0 1 20.5 7.5v9a4 4 0 0 1-4 4h-9a4 4 0 0 1-4-4v-9a4 4 0 0 1 4-4ZM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM17 6.6h.01',
  },
  {
    name: 'YouTube',
    href: BUSINESS.social.youtube,
    path: 'M21.4 8.1a2.5 2.5 0 0 0-1.75-1.77C18.1 6 12 6 12 6s-6.1 0-7.65.33A2.5 2.5 0 0 0 2.6 8.1 26 26 0 0 0 2.3 12a26 26 0 0 0 .3 3.9 2.5 2.5 0 0 0 1.75 1.77C5.9 18 12 18 12 18s6.1 0 7.65-.33a2.5 2.5 0 0 0 1.75-1.77 26 26 0 0 0 .3-3.9 26 26 0 0 0-.3-3.9ZM10 15V9l5.2 3Z',
  },
];
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand" data-reveal="left">
      <a class="brand" href="#top" aria-label="Heaven Furniture Mart, home">
        <img
          class="brand__logo brand__logo--light"
          src={`${BASE}fileslogio/logo-horizontal-light.svg`}
          alt=""
          width="427"
          height="161"
        />
        <img
          class="brand__logo brand__logo--dark"
          src={`${BASE}fileslogio/logo-horizontal-dark.svg`}
          alt=""
          width="427"
          height="161"
        />
      </a>
      <p class="site-footer__tagline">{BUSINESS.tagline}</p>
      <ul class="site-footer__social" aria-label="Social profiles">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.name}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="site-footer__contact" data-reveal="right">
      <h2 class="site-footer__h">Visit &amp; contact</h2>
      <address class="site-footer__address">
        <p>{BUSINESS.address.full}</p>
        <p>
          <a href={BUSINESS.phoneHref}>{BUSINESS.phoneDisplay}</a>
        </p>
        <p>
          <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
        </p>
      </address>
      <a class="btn btn--ghost site-footer__cta" href={BUSINESS.whatsapp} target="_blank" rel="noopener">
        Message us on WhatsApp
      </a>
    </div>
  </div>

  <div class="container site-footer__bar">
    <p>© {year} {BUSINESS.name}. All rights reserved.</p>
    <p>Bespoke furniture · Chattogram, Bangladesh</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-alt);
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    overflow-x: clip;
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* brand column */
  .brand { display: inline-flex; align-items: center; }
  .brand__logo { height: 62px; width: auto; display: block; }
  .brand__logo--dark { display: none; }
  :global(:root[data-theme='dark']) .brand__logo--light { display: none; }
  :global(:root[data-theme='dark']) .brand__logo--dark { display: block; }
  .site-footer__tagline {
    margin-top: 1.1rem;
    color: var(--text-muted);
    font-size: var(--step--1);
    letter-spacing: 0.05em;
  }
  .site-footer__social {
    margin-top: 1.6rem;
    display: flex;
    gap: 0.7rem;
  }
  .site-footer__social a {
    display: inline-grid;
    place-items: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text);
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .site-footer__social a:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }
  .site-footer__social svg { width: 19px; height: 19px; }

  /* contact column */
  .site-footer__h {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .site-footer__address {
    margin-top: 1.1rem;
    font-style: normal;
    line-height: 1.9;
    color: var(--text-muted);
  }
  .site-footer__address a {
    color: var(--text);
    transition: color 0.25s var(--ease);
  }
  .site-footer__address a:hover { color: var(--accent); }
  .site-footer__cta { margin-top: 1.6rem; }

  /* bottom bar */
  .site-footer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  @media (max-width: 720px) {
    .site-footer__inner { grid-template-columns: 1fr; }
  }
</style>
