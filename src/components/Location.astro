---
/* Location — "Visit us": address + contact and an embedded Google Map.
   The map iframe is lazy-loaded (below the fold) so it never touches the
   critical path or the LCP. */
import { BUSINESS } from '../consts';

const details = [
  {
    label: 'Showroom',
    value: BUSINESS.address.full,
    // map pin
    path: 'M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z',
    extra: 'M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  },
  {
    label: 'Phone',
    value: BUSINESS.phoneDisplay,
    href: BUSINESS.phoneHref,
    path: 'M6.5 3.5 9 4l1 4-2 1.5a12 12 0 0 0 6 6L15.5 15l4 1 .5 2.5a2 2 0 0 1-2 2.2A16 16 0 0 1 4.3 5.5a2 2 0 0 1 2.2-2Z',
  },
  {
    label: 'Email',
    value: BUSINESS.email,
    href: `mailto:${BUSINESS.email}`,
    path: 'M3.5 6h17v12h-17ZM4 6.5l8 6 8-6',
  },
];
---
<section class="visit section" id="visit" aria-labelledby="visit-title">
  <div class="container visit__grid">
    <div class="visit__info" data-reveal="left">
      <span class="eyebrow">Visit us</span>
      <h2 id="visit-title" class="section-head__title">
        Come see it <em>in person</em>.
      </h2>
      <p class="visit__intro">
        Step into our Chattogram showroom on Agrabad Access Road — feel the
        materials, judge the finishes, and talk your project through with the
        people who will build it.
      </p>

      <ul class="visit__details">
        {details.map((d) => (
          <li class="visit__detail">
            <span class="visit__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={d.path} />
                {d.extra && <path d={d.extra} />}
              </svg>
            </span>
            <span class="visit__detail-text">
              <span class="visit__detail-label">{d.label}</span>
              {d.href
                ? <a href={d.href}>{d.value}</a>
                : <span>{d.value}</span>}
            </span>
          </li>
        ))}
      </ul>

      <div class="visit__actions">
        <a class="btn btn--primary" href={BUSINESS.map.directions} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.4" />
          </svg>
          Get directions
        </a>
        <a class="link-arrow" href={BUSINESS.map.view} target="_blank" rel="noopener">
          View on Google Maps
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>

    <div class="visit__map" data-reveal="right">
      <iframe
        title="Map showing Heaven Furniture Mart on Agrabad Access Road, Chattogram"
        src={BUSINESS.map.embed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .visit { background: var(--bg-alt); transition: background-color 0.4s var(--ease); }

  .visit__grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .visit__intro {
    margin-top: 1.15rem;
    font-size: var(--step-1);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 46ch;
  }

  .visit__details {
    margin-top: clamp(1.8rem, 3vw, 2.4rem);
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }
  .visit__detail { display: flex; align-items: flex-start; gap: 0.9rem; }
  .visit__icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .visit__icon svg { width: 21px; height: 21px; }
  .visit__detail-text { display: flex; flex-direction: column; gap: 0.15rem; padding-top: 0.15rem; }
  .visit__detail-label {
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  .visit__detail-text > a,
  .visit__detail-text > span:not(.visit__detail-label) {
    color: var(--text);
    font-size: var(--step-0);
  }
  .visit__detail-text a { transition: color 0.25s var(--ease); }
  .visit__detail-text a:hover { color: var(--accent); }

  .visit__actions {
    margin-top: clamp(2rem, 3vw, 2.6rem);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.8rem;
  }

  /* ---- Map ---- */
  .visit__map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .visit__map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  /* Nudge the light Google map toward the page's mood in dark theme */
  :root[data-theme='dark'] .visit__map iframe {
    filter: invert(0.92) hue-rotate(180deg) brightness(0.92) contrast(0.9);
  }

  @media (max-width: 820px) {
    .visit__grid { grid-template-columns: 1fr; }
    .visit__map { aspect-ratio: 3 / 2; }
    .visit__intro { font-size: var(--step-0); }
  }
</style>
