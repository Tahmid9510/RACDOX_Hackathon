---
/* Collections (§4.6) — Living / Bedroom / Dining / Office. Real photography
   carries each card; the brass line-drawing stays on as a small corner badge
   (the lightweight secondary motif from §5). Anchored #collections. */
import { Picture } from 'astro:assets';
import Sofa from './Furniture/Sofa.astro';
import Bed from './Furniture/Bed.astro';
import DiningSet from './Furniture/DiningSet.astro';
import Desk from './Furniture/Desk.astro';

import livingImg from '../assets/images/collection-living.jpg';
import bedroomImg from '../assets/images/collection-bedroom.jpg';
import diningImg from '../assets/images/collection-dining.jpg';
import officeImg from '../assets/images/collection-office.jpg';

const collections = [
  {
    name: 'Living Room',
    body: 'Sofas, armchairs and centre tables that anchor the room in comfort.',
    img: livingImg,
    alt: 'A cream sofa styled with a kilim cushion in a warm, plant-filled living room',
    Art: Sofa,
  },
  {
    name: 'Bedroom',
    body: 'Beds, wardrobes and side tables designed for restful, quiet calm.',
    img: bedroomImg,
    alt: 'A neutral bedroom with a wooden bed frame, bench and soft daylight',
    Art: Bed,
  },
  {
    name: 'Dining',
    body: 'Solid-wood tables and chairs built for years of gathering.',
    img: diningImg,
    alt: 'A solid-wood dining table and chairs in a warm, naturally lit room',
    Art: DiningSet,
  },
  {
    name: 'Office & Study',
    body: 'Executive desks and shelving with a quiet sense of authority.',
    img: officeImg,
    alt: 'A warm wooden desk and shelving in a calm home study',
    Art: Desk,
  },
];
---
<section class="collections section" id="collections" aria-labelledby="collections-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Collections</span>
      <h2 id="collections-title" class="section-head__title">
        Made for every room you live in.
      </h2>
      <p class="section-head__intro">
        Four ranges, one standard of craft. Each begins as a conversation and
        ends as a piece made only for you.
      </p>
    </div>

    <ul class="collections__grid">
      {collections.map(({ name, body, img, alt, Art }, i) => (
        <li class="collection" data-reveal="flip" style={`--reveal-delay:${(i % 2) * 100}ms`}>
          <div class="collection__media">
            <Picture
              src={img}
              formats={['avif', 'webp']}
              alt={alt}
              widths={[320, 500, 760]}
              sizes="(max-width: 560px) 90vw, (max-width: 960px) 45vw, 560px"
              loading="lazy"
              class="collection__img"
            />
            <span class="collection__badge" aria-hidden="true">
              <Art class="collection__glyph" />
            </span>
          </div>
          <div class="collection__text">
            <h3 class="collection__name">{name}</h3>
            <p class="collection__body">{body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .collections__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2.2vw, 1.6rem);
  }

  .collection {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .collection:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .collection__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .collection__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* subtle warm wash so the mixed photos read as one cohesive set */
    transition: transform 0.6s var(--ease);
  }
  .collection__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--overlay-tint);
    mix-blend-mode: multiply;
    opacity: 0.28;
    pointer-events: none;
  }
  .collection:hover .collection__img { transform: scale(1.05); }

  /* small brass line-drawing badge — the retained motif */
  .collection__badge {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    width: 58px;
    height: 42px;
    display: grid;
    place-items: center;
    padding: 0 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid var(--line);
    color: var(--wood);
  }
  .collection__glyph { width: 100%; height: auto; }

  .collection__text { padding: clamp(1.4rem, 3vw, 1.9rem); }
  .collection__name {
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--heading);
  }
  .collection__body {
    margin-top: 0.6rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 40ch;
  }

  @media (max-width: 560px) {
    .collections__grid { grid-template-columns: 1fr; }
  }
</style>
