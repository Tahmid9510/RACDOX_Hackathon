---
/* =========================================================================
   BaseLayout.astro — the document shell.
   - Self-hosted fonts (no render-blocking Google <link>)
   - Full SEO <head>: title/description, canonical, Open Graph, Twitter
   - LocalBusiness (FurnitureStore) JSON-LD structured data
   - Pre-paint theme script (reads localStorage before first paint → no FOUC)
   - Semantic landmarks: <header> and <footer> slots wrap <main>

   Header / Footer components are built in later phases; until then this
   layout renders named <slot>s for them so index.astro stays a clean list.
   ========================================================================= */
/* Latin-only subsets — English page, so we skip cyrillic/greek/vietnamese
   weights to keep the emitted font set small. */
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '../styles/global.css';
import { BUSINESS, SEO, THEME_KEY } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL for the Open Graph / Twitter image. */
  image?: string;
  /** Override the canonical path (defaults to the current page path). */
  canonicalPath?: string;
}

const {
  title = SEO.defaultTitle,
  description = SEO.description,
  image = SEO.ogImage,
  canonicalPath,
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs; BASE_URL is the `base`
// (e.g. "/RACDOX_Hackathon/") so every absolute path is deploy-correct.
const siteOrigin = Astro.site ?? new URL('https://tahmid9510.github.io');
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const withBase = (p: string) => BASE + p.replace(/^\//, '');
const canonicalURL = new URL(withBase(canonicalPath ?? ''), siteOrigin);
const ogImageURL = new URL(withBase(image), siteOrigin);
const faviconHref = withBase('/favicon.svg');
const favicon512 = withBase('/fileslogio/favicon-512.png');

// LocalBusiness / FurnitureStore structured data (§6).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  '@id': `${siteOrigin.origin}/#business`,
  name: BUSINESS.name,
  description: SEO.description,
  slogan: BUSINESS.tagline,
  url: canonicalURL.href,
  image: ogImageURL.href,
  logo: new URL(withBase('/favicon.svg'), siteOrigin).href,
  telephone: BUSINESS.phoneDisplay,
  email: BUSINESS.email,
  foundingDate: BUSINESS.foundingYear,
  priceRange: '$$$',
  currenciesAccepted: 'BDT',
  address: {
    '@type': 'PostalAddress',
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.region,
    addressCountry: BUSINESS.address.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: BUSINESS.geo.lat,
    longitude: BUSINESS.geo.lng,
  },
  hasMap: BUSINESS.map.view,
  founder: {
    '@type': 'Person',
    name: BUSINESS.founder,
    jobTitle: BUSINESS.founderRole,
  },
  areaServed: {
    '@type': 'City',
    name: BUSINESS.address.city,
  },
  sameAs: [
    BUSINESS.social.facebook,
    BUSINESS.social.instagram,
    BUSINESS.social.youtube,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- ===== Pre-paint theme (no FOUC). Default = light; only a stored
         choice overrides it. Keep this first & tiny. ===== -->
    <script is:inline define:vars={{ key: THEME_KEY }}>
      try {
        const stored = localStorage.getItem(key);
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (_) {
        /* private mode / storage blocked → fall back to default light */
      }
    </script>

    <!-- ===== Gate scroll-reveal before paint. The .reveal-on class is added
         ONLY when motion is allowed, so reduced-motion users (and anyone with
         JS disabled) never get hidden content. ===== -->
    <script is:inline>
      try {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('reveal-on');
        }
      } catch (_) {}
    </script>

    <!-- ===== Primary meta ===== -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SEO.keywords} />
    <meta name="author" content={BUSINESS.name} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <!-- ===== Icons & theme colour ===== -->
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="icon" type="image/png" sizes="512x512" href={favicon512} />
    <link rel="apple-touch-icon" href={favicon512} />
    <meta name="theme-color" content={SEO.themeColorLight} />

    <!-- ===== Open Graph (Facebook / WhatsApp link previews) ===== -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BUSINESS.name} — ${BUSINESS.tagline}`} />
    <meta property="og:locale" content={SEO.locale} />

    <!-- ===== Twitter card ===== -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={`${BUSINESS.name} — ${BUSINESS.tagline}`} />

    <!-- ===== Structured data ===== -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <div class="preloader" id="preloader" aria-hidden="true">
      <div class="preloader__box">
        <img class="preloader__logo preloader__logo--light" src={withBase('/fileslogio/logo-mark-light.svg')} alt="" width="120" height="144" />
        <img class="preloader__logo preloader__logo--dark" src={withBase('/fileslogio/logo-mark-dark.svg')} alt="" width="120" height="144" />
        <span class="preloader__bar"><span></span></span>
      </div>
    </div>
    <script is:inline>
      /* Safety net: guarantee the splash is gone even if the CSS animation
         never fires (very old browsers / animations disabled). */
      window.setTimeout(function () {
        var p = document.getElementById('preloader');
        if (p) p.remove();
      }, 2200);
    </script>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />

    <!-- ===== Scroll-reveal: one IntersectionObserver, reveal-once, then
         disconnect each element. No-ops under reduced motion / no support. ===== -->
    <script>
      const els = document.querySelectorAll('[data-reveal]');
      if (
        els.length &&
        'IntersectionObserver' in window &&
        document.documentElement.classList.contains('reveal-on')
      ) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
